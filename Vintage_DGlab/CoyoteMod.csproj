<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AssemblyName>VintageDLab</AssemblyName>
    <RootNamespace>VintageDLab</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <Version>1.3.0</Version>
    <GamePath Condition="'$(GamePath)' == ''">$(VINTAGE_STORY)</GamePath>
    <SupportedGameVersion>1.22.3</SupportedGameVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\v13\**\*.cs" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <Target Name="ValidateRealGame" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GamePath)\VintagestoryAPI.dll')" Text="Set GamePath to the real Vintage Story installation; stubs are not supported." />
    <GetAssemblyIdentity AssemblyFiles="$(GamePath)\VintagestoryAPI.dll">
      <Output TaskParameter="Assemblies" ItemName="GameApiIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'%(GameApiIdentity.Version)' != '$(SupportedGameVersion).0'" Text="Game API version must be $(SupportedGameVersion).0; do not compile release packages against stubs or a different game." />
  </Target>
  <!-- Real Vintage Story game references -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(GamePath)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(GamePath)\Lib\cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
